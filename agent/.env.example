# Copie para .env (o .env está no .gitignore). Nunca grave chave no repositório.

# Modelo via Vertex AI com ADC (gcloud auth application-default login).
# gemini-3.8-flash só responde na localização "global" (us-central1 dá 404).
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=batalha-time-05-xew3
GOOGLE_CLOUD_LOCATION=global
MODELO=gemini-3.8-flash
MODELO_RESERVA=gemini-2.5-flash

# Alternativa só em dev, sem Vertex: GOOGLE_GENAI_USE_VERTEXAI=FALSE e GOOGLE_API_KEY=...

# Dados: csv (padrão; data/extrato_sintetico.csv.gz) ou bigquery (views em agent/sql/, uma consulta por cliente).
DADOS=csv

# Modo de conversa (server/main.py + cabe_no_bolso/runtime.py):
#   gi      prompt da Gi (docs/prompt-gi-2026-09-27.md) verbatim, contexto JSON já calculado, resposta em JSON,
#           checagens em código + validador; o LLM não tem ferramentas de dados. PADRÃO desde 27/09: os 22 exemplos
#           da Gi passaram ao vivo (ver agent/evals/resultado-gi-2026-09-27.md; a regra era >= 80% aprovados).
#   tools   agente com ferramentas (instruction.md) + guardião de texto + o mesmo validador. Continua disponível.
#   auto    o mesmo que o padrão do runtime (gi).
#   sem_llm resposta determinística só com cabe_core (testes; plano B se o modelo cair).
MODO_CONVERSA=gi

# Validador (segundo LlmAgent com o prompt do validador da Gi) nos dois modos. Reprovado => 1 regeneração; reprovado
# de novo ou R8 => mensagem segura. VALIDADOR_ATIVO=false desliga (só checagens em código + guardião).
# Latência no palco (medida em 27/09 02h pela API, modo gi com validador): 6,8 a 8,2 s por turno; 16,6 s quando o validador
# pede 1 regeneração. Duas alavancas, sem tocar no código (docs/11-finops.md §7):
#   MODELO_VALIDADOR=gemini-2.5-flash  validador num modelo mais rápido e mais barato (preço confirmado em config/finops.yaml:
#                                      US$ 0,30 / 2,50 por milhão de tokens, contra 0,75 / 3,75 do 3.8-flash); o agente não muda
#   VALIDADOR_ATIVO=false              1 chamada por turno (~4 s); ficam as checagens em código + guardião; o painel da banca
#                                      mostra "validador desligado" em cada turno
VALIDADOR_ATIVO=true
# MODELO_VALIDADOR=gemini-3.8-flash   # padrão = MODELO; alternativa medida: gemini-2.5-flash
# TOOL_CALLS_POR_TURNO_MAX=8          # teto de chamadas de ferramenta por turno (before_tool, estado temp:); padrão em config/finops.yaml
# BQ_ANALYTICS_DATASET=agent_logs     # liga o BigQueryAgentAnalyticsPlugin do ADK no App (eventos do agente no BigQuery); exige o dataset
#                                     # criado (deploy/CHECKLIST.md) e o extra bigquery (uv sync --extra bigquery). Desligado na demo.
# ACOMPANHAMENTO_COM_LLM=false        # avançar mês continua sem LLM (docs/05 §14); o gatilho 'acompanhamento' existe mas fica desligado
# INSIGHT_COM_LLM=false               # insight do cartão pelo prompt da Gi (modo insight, gatilho fechamento) em vez do texto determinístico;
#                                     # o servidor só chama o modelo para o card quando true (+1 chamada do agente e +1 do validador por sessão)
# CHAMADAS_LLM_POR_SESSAO_MAX=12      # teto de chamadas ao modelo por sessão (padrão em config/finops.yaml); acima, mensagem segura sem chamar o modelo
# LOG_TURNOS=true                    # uma linha JSON por papel por turno no stdout (Cloud Logging: custo_usd, tokens, latência; sem PII) — deploy/metricas.sh
# FINOPS=/caminho/config/finops.yaml  # preços com fonte, piloto e travas; padrão: config/finops.yaml da raiz

# RATE_LIMIT_POR_MINUTO=60      # por IP, só em /api (a banca no Wi-Fi do evento compartilha IP: não apertar demais)
# MAX_CONCORRENCIA=40           # requisições simultâneas em /api (503 acima disso)
# MAX_CORPO_BYTES=16384         # corpo máximo de um POST
# SESSAO_TTL_S=7200             # sessão em memória expira após 2 h sem uso
# ANOMES_FIM_BASE=202512        # último mês da base, para o comparativo "2025 real" do painel

# Opcionais. RAIZ é a raiz do repositório (contém config/, data/, demo/); por padrão é resolvida a partir do código.
# RAIZ=/caminho/para/o/repo
# TAXAS=/caminho/para/config/taxas.yaml
# BIGQUERY_TABELA=batalha-time-05-xew3.hackathon_dados.extrato_sintetico

# Ajustes do agente (opcionais; padrões em cabe_no_bolso/agent.py).
# PENSAMENTO=budget:0     # padrão: thinking_budget=0 (mínimo aceito pelo gemini-3.8-flash no Vertex; 'minimal' dá 400). Alternativas: low|medium|high ou budget:<n>
# TEMPERATURA=0.2
# MAX_TOKENS_SAIDA=2048   # inclui os tokens de raciocínio: com 700 o Gemini 3.8 Flash corta a resposta (MAX_TOKENS)
# LIMITE_CHAMADAS=40      # teto de chamadas ao modelo em evals/rodar.py
